[mysqld]
# Brator — tuned for a read-heavy parts catalogue on a dev machine.

character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# The catalogue is read-heavy and the fitment table is large; a generous buffer
# pool is what keeps the "parts for my car" range scan in memory.
innodb_buffer_pool_size = 1G
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT

# Bulk catalogue imports write in large batches.
innodb_log_file_size = 256M
max_allowed_packet   = 64M

# Fulltext search on product name/sku — the theme's search box needs short terms
# like "K&N" or "oil" to match.
innodb_ft_min_token_size = 2

# Surface slow catalogue queries during development instead of guessing later.
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 0.5
