# Brator Auto Parts — the hosted .env.
#
# Copy to .env ON THE SERVER, not on your laptop, and fill in the four marked values.
# The most common way to break a deploy is to ship the development .env, which is why
# this exists as its own file rather than as comments in that one.
#
#   cp .env.production.example .env
#   docker compose -f compose.yaml -f compose.prod.yaml run --rm app php artisan key:generate
#
# Full steps: docs/DEPLOY.md

APP_NAME="Brator Auto Parts"
APP_ENV=production
# LEAVE BLANK, then run key:generate. Never reuse the development key, and never commit
# whatever lands here — .env is gitignored and must stay that way.
APP_KEY=
APP_DEBUG=false
# The real address, with https. Laravel builds absolute URLs from this, so a stale value
# here is how a hosted shop ends up linking back to localhost.
APP_URL=https://CHANGE-ME.duckdns.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Europe/Skopje

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug on a public site writes every query and every stack frame to disk, which fills a
# small VPS and copies customer data into the log.
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Edge and networking
# ---------------------------------------------------------------------------
# Caddy owns 80 and 443. nginx is pulled back to loopback so nothing but Caddy can
# reach it; the port is kept only so you can curl it on the box while debugging.
APP_BIND=127.0.0.1
APP_PORT=8090

# The domain Caddy gets a certificate for. Must already resolve to this machine's public
# IP, or certificate issuance fails and the site never comes up.
SITE_DOMAIN=CHANGE-ME.duckdns.org
ADMIN_EMAIL=you@example.com

# The Mailpit UI — every receipt the demo "sends" lands there. Leave MAIL_DOMAIN blank to
# not expose it at all. If you do expose it, set a password: it holds every customer name,
# address and order placed on the demo.
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
MAIL_DOMAIN=
MAIL_USER=brator
MAIL_PASSWORD_HASH=

# Keep these on loopback. They are published only so you can reach them from the server
# itself; nothing outside the box should ever connect to them.
DB_PORT_HOST=3310
REDIS_PORT_HOST=6382
MAILPIT_PORT=8030

UID=1000
GID=1000

# ---------------------------------------------------------------------------
# The admin account — read by DatabaseSeeder when you seed.
# ---------------------------------------------------------------------------
# There is no customer login on this shop, so this single account is the whole security
# boundary. The development default is the password "password" under an email address that
# is in the git history; both must change before this is reachable from the internet.
ADMIN_NAME="Stefan Markoski"
ADMIN_LOGIN_EMAIL=CHANGE-ME@example.com
ADMIN_PASSWORD=CHANGE-ME

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=brator
DB_USERNAME=brator
# CHANGE THIS. "secret" is the development default and it is also the MySQL root password.
DB_PASSWORD=CHANGE-ME

SESSION_DRIVER=redis
# 30 days is the development default. Twelve hours is plenty for a demo panel, and this is
# the session that IS the security boundary — there is no customer login to dilute it.
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The site is HTTPS-only behind Caddy, so the session cookie should refuse to travel any
# other way.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# THE ONE SETTING THAT DECIDES WHETHER THIS APP CAN LIVE ON A GIVEN HOST.
#
# "public" writes uploaded images to the server's own disk. Correct on a VM, your laptop or
# anything with real storage — and then storage/app/public is the one directory worth
# backing up, because nothing else can regenerate it.
#
# "s3" is required on any host with an EPHEMERAL filesystem, where the disk is wiped on
# every deploy and restart: Render, Laravel Cloud, Codespaces, Vercel. Fill in the AWS_*
# block below; any S3-compatible service works — Cloudflare R2, Supabase Storage, Backblaze
# — via AWS_ENDPOINT with AWS_USE_PATH_STYLE_ENDPOINT=true.
#
# Switching this does NOT move files that already exist. See docs/DEPLOY.md.
UPLOADS_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail — still Mailpit, deliberately.
# ---------------------------------------------------------------------------
# A demo shop must not be able to email a real person by accident, and Mailpit makes that
# impossible while still letting anyone watch the receipts arrive. Swapping to a real
# provider later is these four lines and nothing else — the app sends exactly one message.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="shop@brator.mk"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Shop settings
# ---------------------------------------------------------------------------
SHOP_VAT_RATE=18
SHOP_CURRENCY=MKD

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SHOP_PHONE=
SHOP_EMAIL=orders@brator.mk
SHOP_ADDRESS=
