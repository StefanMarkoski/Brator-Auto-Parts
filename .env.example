APP_NAME="Brator Auto Parts"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Europe/Skopje

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Host port mapping (compose.yaml reads these).
# Chosen to stay clear of the Inspectio Sail stack already running locally.
# ---------------------------------------------------------------------------
APP_PORT=8090
DB_PORT_HOST=3310
REDIS_PORT_HOST=6382
MAILPIT_PORT=8030

# The php-fpm container runs as this uid/gid so files it writes stay editable on
# the host. Set here rather than exported, because bash makes $UID readonly.
# Check yours with `id -u` / `id -g` before first build.
UID=1000
GID=1000

# ---------------------------------------------------------------------------
# Database — MySQL 8.4 in the mysql service. Hostnames are service names.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=brator
DB_USERNAME=brator
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail — Mailpit. The receipt is delivered by email, so this is a core
# dependency, not a convenience. Inbox: http://localhost:8030
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="shop@brator.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Shop settings
# ---------------------------------------------------------------------------
# Prices are stored NET of VAT and VAT is added at checkout (decided 2026-08-05).
# Single rate, so it lives here rather than as a column on 50,000 product rows.
SHOP_VAT_RATE=18
SHOP_CURRENCY=MKD

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
